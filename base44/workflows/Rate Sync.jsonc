{
  "description": "Synchronise automatiquement les taux de change depuis Binance P2P (USDT) toutes les heures et recalcule les prix Achat/Vente avec la marge configur\u00e9e.",
  "name": "Rate Sync",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 * * * *",
      "one_time_date": null,
      "timezone": "Africa/Bujumbura",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "rate_sync",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "sync": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncBinanceRates",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Synchroniser Binance",
            "description": "Rafra\u00eechit les taux P2P USDT"
          }
        }
      }
    ]
  }
}