{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "username": {
      "type": "string",
      "description": "Public pseudonym chosen by the member (displayed to referrer)"
    },
    "legal_name": {
      "type": "string",
      "description": "Full legal name provided during KYC"
    },
    "phone": {
      "type": "string",
      "description": "Phone number including country code"
    },
    "country": {
      "type": "string",
      "description": "Country of residence"
    },
    "id_document_type": {
      "type": "string",
      "enum": [
        "national_id",
        "passport",
        "driver_license"
      ],
      "description": "Type of identity document uploaded for KYC"
    },
    "id_document_uri": {
      "type": "string",
      "description": "Private storage URI of the uploaded identity document"
    },
    "face_uri": {
      "type": "string",
      "description": "Private storage URI of the uploaded selfie (face photo) for KYC"
    },
    "kyc_status": {
      "type": "string",
      "enum": [
        "not_submitted",
        "pending",
        "approved",
        "rejected"
      ],
      "default": "not_submitted",
      "description": "KYC verification status"
    },
    "kyc_rejection_reason": {
      "type": "string",
      "description": "Reason given by admin when rejecting KYC"
    },
    "disabled": {
      "type": "boolean",
      "default": false,
      "description": "When true, the account is blocked by an admin and the app denies access"
    },
    "referral_code": {
      "type": "string",
      "description": "Unique referral code the user shares with their contacts"
    },
    "referred_by": {
      "type": "string",
      "description": "User id of the referrer who invited this user"
    }
  },
  "required": [
    "role"
  ]
}