{
  "name": "Currency",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "description": "ISO currency code (e.g. USD, BIF, KSH, RWF, TZS, CDF, UGX, AED, USDT)"
    },
    "name": {
      "type": "string",
      "description": "Full currency name"
    },
    "symbol": {
      "type": "string",
      "description": "Currency symbol"
    },
    "flag_emoji": {
      "type": "string",
      "description": "Flag emoji or icon for the currency"
    },
    "type": {
      "type": "string",
      "enum": [
        "fiat",
        "crypto"
      ],
      "default": "fiat",
      "description": "Whether this is a fiat or crypto currency"
    },
    "binance_rate": {
      "type": "number",
      "default": 0,
      "description": "Taux de reference (par USD). Source Binance P2P en auto, ou valeur manuelle definie par l'admin lorsque manual_override est actif."
    },
    "fee_percent": {
      "type": "number",
      "default": 5,
      "description": "Marge en pourcentage appliquee au taux de reference lorsque spread_fixed = 0. Buy = ref * (1 + fee%), Sell = ref * (1 - fee%)."
    },
    "spread_fixed": {
      "type": "number",
      "default": 0,
      "description": "Spread fixe en unites de la devise (ex: 150 BIF). Prioritaire sur fee_percent. Buy = reference + spread, Sell = reference - spread."
    },
    "buy_rate": {
      "type": "number",
      "default": 0,
      "description": "Taux d'achat client (par USD) = reference + spread. Affiche en VERT. Prix auquel l'utilisateur achete des USDT (superieur au taux de reference)."
    },
    "sell_rate": {
      "type": "number",
      "default": 0,
      "description": "Taux de vente client (par USD) = reference - spread. Affiche en BLANC. Prix auquel l'utilisateur vend des USDT (inferieur au taux de reference)."
    },
    "manual_override": {
      "type": "boolean",
      "default": false,
      "description": "Si vrai, la synchro auto ne remplace PAS le taux de reference (l'admin le definit manuellement). Les taux Buy/Sell restent calcules automatiquement a partir de la reference + spread."
    },
    "last_synced_at": {
      "type": "string",
      "description": "ISO timestamp of the last rate sync for this currency"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this currency is available for exchange"
    }
  },
  "required": [
    "code",
    "name",
    "buy_rate",
    "sell_rate",
    "active"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}