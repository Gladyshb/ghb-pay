{
  "name": "Currency",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "description": "ISO currency code (e.g. USD, BIF, KSH, RWF, TZS, CDF, UGX, AED, USDT)"
    },
    "name": {
      "type": "string",
      "description": "Full currency name"
    },
    "symbol": {
      "type": "string",
      "description": "Currency symbol"
    },
    "flag_emoji": {
      "type": "string",
      "description": "Flag emoji or icon for the currency"
    },
    "type": {
      "type": "string",
      "enum": [
        "fiat",
        "crypto"
      ],
      "default": "fiat",
      "description": "Whether this is a fiat or crypto currency"
    },
    "binance_rate": {
      "type": "number",
      "default": 0,
      "description": "Live Binance P2P USDT market rate for this fiat (per USD). Source of truth for buy/sell computation."
    },
    "fee_percent": {
      "type": "number",
      "default": 5,
      "description": "Margin / fee percentage applied on top of the Binance rate (admin-configurable per currency)."
    },
    "buy_rate": {
      "type": "number",
      "default": 0,
      "description": "Rate at which the platform buys this currency (per USD) = Binance rate - fee%"
    },
    "sell_rate": {
      "type": "number",
      "default": 0,
      "description": "Rate at which the platform sells this currency (per USD) = Binance rate + fee%"
    },
    "manual_override": {
      "type": "boolean",
      "default": false,
      "description": "When true, Binance sync keeps the live rate display but does NOT overwrite buy_rate/sell_rate (admin manual values preserved)."
    },
    "last_synced_at": {
      "type": "string",
      "description": "ISO timestamp of the last Binance rate sync for this currency"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this currency is available for exchange"
    }
  },
  "required": [
    "code",
    "name",
    "buy_rate",
    "sell_rate",
    "active"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}