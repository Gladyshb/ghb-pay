{
  "name": "SupportLink",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "whatsapp_direct",
        "whatsapp_group",
        "phone"
      ],
      "description": "Kind of support link"
    },
    "label": {
      "type": "string",
      "description": "Display label"
    },
    "url": {
      "type": "string",
      "description": "WhatsApp or external URL"
    },
    "phone": {
      "type": "string",
      "description": "Phone number to display"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this link is shown"
    }
  },
  "required": [
    "type",
    "label",
    "active"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}