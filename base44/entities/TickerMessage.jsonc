{
  "name": "TickerMessage",
  "type": "object",
  "properties": {
    "text": {
      "type": "string",
      "description": "Message displayed in the scrolling ticker"
    },
    "emoji": {
      "type": "string",
      "default": "\u26a1",
      "description": "Emoji prefix for the message"
    },
    "order": {
      "type": "number",
      "default": 0,
      "description": "Sort order (lower first)"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this message appears in the ticker"
    }
  },
  "required": [
    "text",
    "active"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}