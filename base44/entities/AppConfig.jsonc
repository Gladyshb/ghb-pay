{
  "name": "AppConfig",
  "type": "object",
  "properties": {
    "binance_proxy_url": {
      "type": "string",
      "description": "URL du worker Cloudflare qui proxy les requetes Binance P2P (ex: https://xxx.workers.dev/)"
    }
  },
  "required": [],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}