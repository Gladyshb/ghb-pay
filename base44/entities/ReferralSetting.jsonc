{
  "name": "ReferralSetting",
  "type": "object",
  "properties": {
    "commission_type": {
      "type": "string",
      "enum": [
        "percent",
        "fixed"
      ],
      "default": "percent",
      "description": "percent = percentage of the app fees collected on the referred user's first validated transfer; fixed = flat USD amount credited to the referrer"
    },
    "commission_value": {
      "type": "number",
      "default": 20,
      "description": "In percent mode: percentage of the app fees paid to the referrer (default 20). In fixed mode: flat USD amount."
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Whether the referral program is enabled"
    }
  },
  "required": [
    "commission_type",
    "commission_value",
    "active"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}