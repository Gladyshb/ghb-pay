{
  "name": "DepositRequest",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Id of the user who made the deposit"
    },
    "user_name": {
      "type": "string",
      "description": "Display name of the user"
    },
    "user_email": {
      "type": "string",
      "description": "Email of the user"
    },
    "amount": {
      "type": "number",
      "description": "Amount deposited"
    },
    "currency": {
      "type": "string",
      "description": "Currency of the deposit"
    },
    "deposit_address_id": {
      "type": "string",
      "description": "Id of the deposit address used"
    },
    "deposit_address_label": {
      "type": "string",
      "description": "Label of the deposit address used"
    },
    "receipt_uri": {
      "type": "string",
      "description": "Private storage URI of the uploaded receipt screenshot"
    },
    "sender_reference": {
      "type": "string",
      "description": "Reference or transaction id shown on the payment"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending",
      "description": "Approval status"
    },
    "admin_notes": {
      "type": "string",
      "description": "Internal admin notes"
    },
    "rejection_reason": {
      "type": "string",
      "description": "Reason for rejection"
    },
    "credited_amount": {
      "type": "number",
      "description": "Amount credited to the wallet once approved"
    }
  },
  "required": [
    "user_id",
    "amount",
    "currency",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}