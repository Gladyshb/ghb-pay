{
  "name": "Announcement",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Headline of the promotional banner"
    },
    "body": {
      "type": "string",
      "description": "Description text of the announcement"
    },
    "emoji": {
      "type": "string",
      "default": "\ud83d\udce2",
      "description": "Icon/emoji shown with the banner"
    },
    "cta_text": {
      "type": "string",
      "description": "Optional call-to-action button label"
    },
    "cta_url": {
      "type": "string",
      "description": "Optional link the CTA points to"
    },
    "order": {
      "type": "number",
      "default": 0,
      "description": "Sort order (lower first)"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this announcement is shown on the homepage"
    }
  },
  "required": [
    "title",
    "active"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}