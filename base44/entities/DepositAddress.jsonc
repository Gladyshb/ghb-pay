{
  "name": "DepositAddress",
  "type": "object",
  "properties": {
    "provider": {
      "type": "string",
      "description": "Name of the deposit provider (e.g. Lumicash, EcoCash, Zelle, M-Pesa, USDT TRC20)"
    },
    "type": {
      "type": "string",
      "enum": [
        "mobile_money",
        "bank",
        "crypto",
        "international"
      ],
      "description": "Category of the deposit method"
    },
    "label": {
      "type": "string",
      "description": "Display label for the address"
    },
    "account_info": {
      "type": "string",
      "description": "Account number, phone, IBAN or wallet address to send funds to"
    },
    "account_holder": {
      "type": "string",
      "description": "Name on the account"
    },
    "currency": {
      "type": "string",
      "description": "Currency accepted by this address"
    },
    "country": {
      "type": "string",
      "description": "Country or region of the provider"
    },
    "network": {
      "type": "string",
      "description": "Network for crypto addresses (e.g. TRC20, ERC20, BEP20)"
    },
    "instructions": {
      "type": "string",
      "description": "Extra instructions shown to the user"
    },
    "accent_color": {
      "type": "string",
      "default": "#D4AF37",
      "description": "Accent color (hex) used to style this method's icon and card on the deposit page"
    },
    "icon": {
      "type": "string",
      "description": "Emoji or short symbol displayed as this method's icon (e.g. \ud83d\udcf1, \ud83c\udfe6, \u20ae, \ud83c\udf0d)"
    },
    "card_style": {
      "type": "string",
      "enum": [
        "standard",
        "highlighted"
      ],
      "default": "standard",
      "description": "Card presentation on the deposit page: standard (subtle) or highlighted (accent border)"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this address is shown to users for deposits"
    }
  },
  "required": [
    "provider",
    "type",
    "account_info",
    "currency",
    "active"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}